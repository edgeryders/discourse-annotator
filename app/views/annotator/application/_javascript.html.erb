<%#
# Javascript Partial

This partial imports the necessary javascript on each page.
By default, it includes the application JS,
but each page can define additional JS sources
by providing a `content_for(:javascript)` block.
%>


<% Administrate::Engine.javascripts.each do |js_path| %>
  <%= javascript_include_tag js_path %>
<% end %>

<%= javascript_include_tag 'discourse-annotator/vendor/cocoon' %>
<%= javascript_include_tag 'discourse-annotator/vendor/jquery-1.7.min' %>
<%= javascript_include_tag 'discourse-annotator/vendor/jquery-ui.min' %>
<%= javascript_include_tag 'discourse-annotator/vendor/selectize.min' %>

<%= javascript_include_tag 'discourse-annotator/vendor/annotator-full.1.2.5.modified' %>
<%# https://github.com/annotorious/annotorious
    NOTE: All occurrences of "window.pageYOffset" were replaced with "0" as otherwise the Annotator popover is positioned
    incorrectly when the page is scrolled down. %>
<%= javascript_include_tag 'discourse-annotator/vendor/annotorious.okfn.0.3.modified' %>

<%= javascript_include_tag 'discourse-annotator/vendor/video.4.2.2.min' %>
<%= javascript_include_tag 'discourse-annotator/vendor/rangeslider.min' %>
<%= javascript_include_tag 'discourse-annotator/vendor/ova.min.modified' %>

<%= javascript_include_tag 'discourse-annotator/vendor/annotator.plugin.mytags' %>
<%= javascript_include_tag 'discourse-annotator/vendor/tagify.min' %>

<%= javascript_include_tag 'discourse-annotator/application' %>


<%= yield :javascript %>

<% if Rails.env.test? %>
  <%= javascript_tag do %>
    $.fx.off = true;
    $.ajaxSetup({ async: false });
  <% end %>
<% end %>
